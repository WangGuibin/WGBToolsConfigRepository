#! /bin/bash
#调用: webServer -p 8080 
IP=$(ifconfig | sed -e '/.*inet /!d;s///;s/ .*//' | tail -n 1)
IP_PORT=8080
while getopts "p:" opt; do
  case $opt in
    p)
       IP_PORT=$OPTARG 
      ;;
    \?)
      IP_PORT=8080 
      ;;
  esac
done

CurrentDir=`pwd`
echo "🚀 当前目录为:${CurrentDir},WebServer已开启"
echo "🏡 地址为: http://${IP}:${IP_PORT}"
echo "🔥 欢迎使用~ 🔥"
python -m SimpleHTTPServer $IP_PORT
