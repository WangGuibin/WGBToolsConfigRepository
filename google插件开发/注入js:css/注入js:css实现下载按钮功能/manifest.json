{
	"manifest_version": 2,
	"name": "下载MMAS视频",
	"version": "1.0",
	"description": "动态注入js/css实现一个下载按钮",
	"author": "𝘾𝙤𝙙𝙚𝙧𝙒𝙂𝘽",
	"icons": {
		"48": "icon.png",
		"128": "icon.png"
	},
	"browser_action": {
		"default_icon": "icon.png",
		"default_popup": "popup.html"
	},
	"content_scripts": [
		{
			"matches": [
				"https://ph-mmas-admin-open-stg1.paic.com.cn/video/load*",
				"http://ph-mmas-admin-open-stg1.paic.com.cn/video/load*"
			],
			"js": [
				"content-script.js"
			],
			"css": [
				"custom.css"
			]
		}
	],
	"web_accessible_resources": [
		"inject.js"
	]
}