{
	"manifest_version": 2,
	"name": "下载MMAS视频小插件",
	"version": "1.0.0",
	"description": "pageAction演示",
	"icons": {
		"16": "img/icon.png",
		"48": "img/icon.png",
		"128": "img/icon.png"
	},
	"page_action": {
		"default_icon": "img/icon.png",
		"default_title": "MMAS视频下载插件"
	},
	"permissions": [
		"declarativeContent",
		"contextMenus",
        "tabs"
	],
	"background": {
