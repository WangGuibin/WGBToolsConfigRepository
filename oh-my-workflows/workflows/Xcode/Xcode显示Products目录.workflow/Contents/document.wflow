				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>运行Shell脚本</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#Xcode 显示Products目录  有些新建的项目不显示这个目录 想要找编译产物得找很深的目录 感觉很烦 写个脚本自动暴露出来好了
#原理是修改Xcode项目包内容里的项目配置即project.pbxproj文件, 找到mainGroup 提取出来替换掉 productRefGroup的值
# 调用 sh xxx.sh Demo.xcodeproj 即可 可以制作成快捷菜单 选中工程文件找到对应的菜单执行脚本即可
if [[ "${1##*.}"x = "xcodeproj"x ]];
then
filePath="${1}/project.pbxproj"
mainStr=$(cat $filePath | grep "mainGroup")
mainValue=${mainStr##*=}

lineNum=`grep -n 'productRefGroup' ${filePath} | cut -d ":" -f 1`
sed -i "" "${lineNum}d" ${filePath} #删除该行
#插入这行
sed -i '' ''"${lineNum}"'i\
    '"productRefGroup = ${mainValue} /* Products */"'\
    ' ${filePath}
else
    osascript -e "display alert \"⚠️\n该文件格式有误,确定是否为Xcode工程文件(格式为.xcodeproj的文件)\""
fi</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/zsh</string>
